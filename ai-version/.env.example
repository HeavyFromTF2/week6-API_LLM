# Copy this file to .env and fill in real values before running with a real LLM call.

# --- Server ---
PORT=3000

# --- LLM kill switch ---
# "false" disables all AI calls; the API falls back to a safe, deterministic
# response (category "Other", priority "low") instead of calling any model.
LLM_ENABLED=true

# --- LLM stub mode ---
# "1" makes llmClient return a fake, heuristic-based response instead of
# calling OpenRouter, so you can develop/test without spending quota.
LLM_STUB=0

# --- OpenRouter provider ---
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_MODEL=openai/gpt-4o-mini

# --- Timeouts ---
LLM_TIMEOUT_MS=15000
